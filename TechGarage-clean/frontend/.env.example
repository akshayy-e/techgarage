# Local development
VITE_API_BASE_URL=http://localhost:8080/api

# Production example
# VITE_API_BASE_URL=https://api.your-domain.com/api

# Production: set this to the deployed Spring Boot API base URL.

# Optional Razorpay public key. Never put the Razorpay secret here.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
